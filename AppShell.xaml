<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Equiparts.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:views="clr-namespace:Equiparts.Views"
    FlyoutBehavior="Disabled"
    Shell.TabBarForegroundColor="{StaticResource Accent}"
    Shell.TabBarUnselectedColor="{StaticResource BodyText}">

    <!-- ROUTE: loading - Initial loading/splash screen -->
    <ShellContent
        Title="Loading"
        ContentTemplate="{DataTemplate views:InitialLoadingActivityIndicator}"
        Route="loading"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False"/>

    <!-- ROUTE: login - User authentication -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False"/>

    <TabBar Route="app">
        <Tab Title="Home"
             Route="home">
            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Home}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:HomePage}"/>
        </Tab>


        <Tab Title="Catalog">


            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.ThLarge}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}"/>
        </Tab>

        <Tab Title="Cart">
            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.ShoppingCart}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:CartPage}"/>
        </Tab>

        <!-- <Tab Title="Orders">
            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.DiceD6}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:OrdersPage}"
                          Route="orders"/>
        </Tab> -->

        <Tab Title="Profile">
            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.UserCircle}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}"
                          Route="profile"/>
        </Tab>

        <!-- <Tab Title="{x:Static resources:AppResources.MoreTab}">
            <Tab.Icon>
                <FontImageSource FontFamily="FontAwesome"
                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Home}"/>
            </Tab.Icon>

            <ShellContent ContentTemplate="{DataTemplate views:MoreInfoPage}"/>
        </Tab> -->

    </TabBar>

</Shell>
