<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Equiparts.Controls"
             xmlns:fontresources="clr-namespace:Equiparts.Extensions"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Equiparts.Controls.AppHeaderView"
             x:Name="headerControl">

    <Grid HeightRequest="{Binding MainViewHeight, Source={x:Reference headerControl}}">

        <GraphicsView x:Name="HeaderGraphics"
                      HeightRequest="{Binding CurveHeight, Source={x:Reference headerControl}}"
                      VerticalOptions="Start"
                      InputTransparent="True"/>

        <VerticalStackLayout Padding="20,26,20,0"
                             Spacing="16"
                             VerticalOptions="Start">

            <!-- Brand row -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">

                <Border Grid.Column="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="6"
                        BackgroundColor="White"
                        Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Image Source="ep_logo_new"
                           Aspect="AspectFit"/>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="0">

                    <Label Text="{Binding HeaderTitle, Source={x:Reference headerControl}}"
                           FontFamily="SpaceGroteskBold"
                           FontSize="18"
                           TextColor="White"/>

                    <Label Text="{Binding HeaderSubtitle, Source={x:Reference headerControl}}"
                           IsVisible="{Binding HeaderSubtitle, Source={x:Reference headerControl}, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                           FontFamily="GeistRegular"
                           FontSize="11"
                           TextColor="#CBD5E1"/>

                </VerticalStackLayout>

                <Border Grid.Column="2"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        BackgroundColor="#26FFFFFF"
                        Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NotificationCommand, Source={x:Reference headerControl}}"/>
                    </Border.GestureRecognizers>

                    <Label Text="{x:Static fontresources:FontAwesomeIcons.Bell}"
                           FontFamily="FontAwesome"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

            </Grid>

            <!-- Search bar -->
            <Border BackgroundColor="White"
                    Padding="16,0"
                    HeightRequest="52"
                    Stroke="Transparent"
                    IsVisible="{Binding ShowSearchBar, Source={x:Reference headerControl}}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#33000000"
                            Offset="0,6"
                            Radius="12"
                            Opacity="0.18"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">

                    <Label Grid.Column="0"
                           Text="{x:Static fontresources:FontAwesomeIcons.Search}"
                           FontFamily="FontAwesome"
                           FontSize="16"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SearchCommand, Source={x:Reference headerControl}}"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <controls:BorderlessEntry Grid.Column="1"
                                              Placeholder="{Binding SearchPlaceholder, Source={x:Reference headerControl}}"
                                              Text="{Binding SearchQuery, Source={x:Reference headerControl}}"
                                              ReturnCommand="{Binding SearchCommand, Source={x:Reference headerControl}}"
                                              BackgroundColor="Transparent"
                                              VerticalOptions="Center"/>

                    <Label Grid.Column="2"
                           Text="{x:Static fontresources:FontAwesomeIcons.Microphone}"
                           FontFamily="FontAwesome"
                           FontSize="16"
                           TextColor="{StaticResource MutedTextColor}"
                           VerticalOptions="Center"/>

                </Grid>

            </Border>

        </VerticalStackLayout>

    </Grid>

</ContentView>
