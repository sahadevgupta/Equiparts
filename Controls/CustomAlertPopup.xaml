<?xml version="1.0" encoding="utf-8" ?>
<mopup:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:mopup="clr-namespace:Mopups.Pages;assembly=Mopups"
               xmlns:mopupsanim="clr-namespace:Mopups.Animations;assembly=Mopups"
               x:Class="Equiparts.Controls.CustomAlertPopup"
               x:Name="customAlertPopup"
               BackgroundColor="{StaticResource PopupBackground}"
               CloseWhenBackgroundIsClicked="False">

    <mopup:PopupPage.Animation>
        <mopupsanim:MoveAnimation
            DurationIn="300"
            DurationOut="200"
            EasingIn="SinIn"
            EasingOut="SinOut"
            PositionIn="Center"
            PositionOut="Center"/>
    </mopup:PopupPage.Animation>

    <Border StyleClass="Card"
                Padding="24"
                Margin="24,0"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="20">
                <Image HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="FontAwesome"
                                         Size="48"
                                         Glyph="{Binding Icon, Source={x:Reference customAlertPopup}}"
                                         Color="{Binding IconTintColor, Source={x:Reference customAlertPopup}}"/>
                    </Image.Source>
                </Image>

                <Label Text="{Binding Message, Source={x:Reference customAlertPopup}}"
                       StyleClass="Body"
                       HorizontalTextAlignment="Center"/>

                <Grid ColumnSpacing="12"
                      HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Text="{Binding CancelText, Source={x:Reference customAlertPopup}}"
                            BackgroundColor="{StaticResource ChipBackground}"
                            TextColor="{StaticResource ChipText}"
                            MinimumWidthRequest="100"
                            Clicked="OnCancelClicked"
                            IsVisible="False"/>

                    <Button Grid.Column="1"
                            Text="{Binding AcceptText, Source={x:Reference customAlertPopup}}"
                            MinimumWidthRequest="100"
                            Clicked="OnAcceptClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
</mopup:PopupPage>
