<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page -->

    <Style TargetType="ContentPage"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{StaticResource BackgroundColor}"/>
    </Style>

    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{StaticResource PrimaryColor}"/>
        <Setter Property="ForegroundColor"
                Value="White"/>
        <Setter Property="TitleColor"
                Value="White"/>
    </Style>

    <!-- Title: headline weight, Space Grotesk, Primary navy -->

    <Style TargetType="Label"
           Class="Title">

        <Setter Property="FontSize"
                Value="24"/>

        <Setter Property="FontFamily"
                Value="SpaceGroteskBold"/>

        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
    </Style>

    <!-- Section -->

    <Style TargetType="Label"
           Class="SectionTitle">

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>

        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
    </Style>

    <!-- Body: Geist, Neutral carbon-slate copy color -->

    <Style TargetType="Label"
           Class="Body">

        <Setter Property="FontSize"
                Value="15"/>

        <Setter Property="FontFamily"
                Value="GeistRegular"/>

        <Setter Property="TextColor"
                Value="{StaticResource PrimaryTextColor}"/>
    </Style>

    <!-- Price: headline-sm weight, Primary navy (crimson is reserved for
         actions/alerts, not passive price display - see DESIGN.md) -->

    <Style TargetType="Label"
           Class="Price">

        <Setter Property="FontSize"
                Value="20"/>

        <Setter Property="FontFamily"
                Value="SpaceGroteskBold"/>

        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
    </Style>


    <Style TargetType="Button">

        <Setter Property="BackgroundColor"
                Value="{StaticResource AccentColor}"/>

        <Setter Property="BorderColor"
                Value="{StaticResource PrimaryColor}"/>

        <Setter Property="BorderWidth"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="0"/>

        <Setter Property="HeightRequest"
                Value="48"/>

        <Setter Property="TextColor"
                Value="White"/>

        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>

        <Setter Property="FontSize"
                Value="15"/>

        <!-- <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PrimaryColor}"
                    Offset="2,2"
                    Radius="0"
                    Opacity="1"/>
        </Setter> -->

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TranslationX"
                                    Value="2"/>
                            <Setter Property="TranslationY"
                                    Value="2"/>
                            <!-- <Setter Property="Opacity"
                                    Value="0.65"/>
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource PrimaryColor}"
                                        Offset="0,0"
                                        Radius="0"
                                        Opacity="0"/>
                            </Setter> -->
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource DisabledColor}"/>
                            <Setter Property="BorderColor"
                                    Value="{StaticResource DisabledColor}"/>
                            <Setter Property="TextColor"
                                    Value="White"/>
                            <!-- <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource PrimaryColor}"
                                        Offset="0,0"
                                        Radius="0"
                                        Opacity="0"/>
                            </Setter> -->
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary Button (Navy Structural) -->
    <Style TargetType="Button"
           x:Key="SecondaryButtonStyle">
        <Setter Property="BackgroundColor"
                Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderColor"
                Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderWidth"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="0"/>
        <Setter Property="HeightRequest"
                Value="48"/>
        <Setter Property="TextColor"
                Value="White"/>
        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource SecondaryColor}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource DisabledColor}"/>
                            <Setter Property="BorderColor"
                                    Value="{StaticResource DisabledColor}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Tertiary Button (Schematic Outline) -->
    <Style TargetType="Button"
           x:Key="TertiaryButtonStyle">
        <Setter Property="BackgroundColor"
                Value="Transparent"/>
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderColor"
                Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderWidth"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="0"/>
        <Setter Property="HeightRequest"
                Value="48"/>
        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource SurfaceInsetColor}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{StaticResource DisabledColor}"/>
                            <Setter Property="BorderColor"
                                    Value="{StaticResource DisabledColor}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Card: zero-radius, flat (Level 0 substrate - no shadow, per DESIGN.md) -->

    <Style TargetType="Border"
           Class="Card">

        <Setter Property="BackgroundColor"
                Value="{StaticResource CardColor}"/>

        <Setter Property="Stroke"
                Value="{StaticResource BorderColor}"/>

        <Setter Property="StrokeThickness"
                Value="1"/>

        <Setter Property="StrokeShape">

            <Setter.Value>

                <Rectangle/>

            </Setter.Value>

        </Setter>

        <Setter Property="Padding"
                Value="12"/>

        <Setter Property="Margin"
                Value="8,4"/>
    </Style>

    <!-- Shared section card, used by Checkout/OrderDetails/etc. instead of each
         page defining its own identical copy. -->
    <Style TargetType="Border"
           x:Key="SectionCardStyle">
        <Setter Property="BackgroundColor"
                Value="{StaticResource CardColor}"/>
        <Setter Property="Stroke"
                Value="{StaticResource BorderColor}"/>
        <Setter Property="StrokeShape"
                Value="Rectangle"/>
        <Setter Property="Padding"
                Value="16"/>
    </Style>

    <Style TargetType="Label"
           x:Key="SectionTitleLabelStyle">
        <Setter Property="FontSize"
                Value="16"/>
        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
    </Style>

    <!-- Referenced by Controls/ExtendedEntry.xaml: title/support/error labels and
         the field entry's own text/placeholder styling. -->
    <Style TargetType="Label"
           x:Key="TitleStyleBlackBold">
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryColor}"/>
    </Style>

    <Style TargetType="Label"
           x:Key="SupportLabelStyleBlackRegular">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="FontFamily"
                Value="GeistRegular"/>
        <Setter Property="TextColor"
                Value="{StaticResource SecondaryTextColor}"/>
    </Style>

    <Style TargetType="Label"
           x:Key="ErrorStyleBlackRegular">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="FontFamily"
                Value="GeistRegular"/>
        <Setter Property="TextColor"
                Value="{StaticResource ErrorColor}"/>
    </Style>

    <Style TargetType="Entry"
           x:Key="FieldEntryStyleGreyRegular">
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="FontFamily"
                Value="GeistRegular"/>
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryTextColor}"/>
        <Setter Property="PlaceholderColor"
                Value="{StaticResource MutedTextColor}"/>
    </Style>

    <Style TargetType="Label"
           x:Key="TitleStyle">
        <Setter Property="FontSize"
                Value="20"/>
        <Setter Property="VerticalOptions"
                Value="Center"/>
        <Setter Property="FontFamily"
                Value="SpaceGroteskSemibold"/>
    </Style>

    <!-- Default Label: every unstyled Label gets the brand font and ink color. -->
    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryTextColor}"/>
        <Setter Property="FontFamily"
                Value="GeistRegular"/>
    </Style>

    <!-- Default Border ("card" look used app-wide unless a page overrides it
         locally for flat badges/chips): Slate-50 surface, hairline border,
         zero radius, no shadow - Level 0 flat substrate per DESIGN.md. Pages
         that need a raised (Level 1+) treatment set their own hard offset
         Shadow locally rather than relying on this default. -->
    <Style TargetType="Border">
        <Setter Property="Stroke"
                Value="{StaticResource BorderColor}"/>
        <Setter Property="StrokeThickness"
                Value="1"/>
        <Setter Property="BackgroundColor"
                Value="{StaticResource CardColor}"/>
        <Setter Property="StrokeShape">
            <Rectangle/>
        </Setter>
    </Style>

</ResourceDictionary>
