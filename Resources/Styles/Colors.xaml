<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============================================================
         "Technical Schematic Industrial" design system (see DESIGN.md):
         precision telemetry crimson + deep industrial navy on a Slate
         neutral scale, zero-radius shapes, hard mechanical shadows.
         These are the single source of truth for the app theme.
         ============================================================ -->

    <!-- Primary / Secondary (DESIGN.md "Secondary": Deep Industrial Navy -
         structural headers/toolbars/tab bar; Slate-800 as its lighter
         hover/active variant) -->
    <Color x:Key="PrimaryColor">#0E1826</Color>
    <Color x:Key="SecondaryColor">#1E293B</Color>

    <!-- Accent (DESIGN.md "Primary": Precision Telemetry Crimson) -->
    <Color x:Key="AccentColor">#C92027</Color>
    <Color x:Key="AccentColorDark">#A11A1F</Color>
    <Color x:Key="AccentColorLight">#E2949A</Color>

    <!-- Tertiary: Heavy Equipment Amber - OEM verification, low-stock/rating accents -->
    <Color x:Key="TertiaryColor">#E59F1C</Color>

    <!-- Background / Surface: pure-white canvas, Slate-50 card/container fill,
         Slate-100 nested/inset wells (spec tables, inactive states, chips) -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F8FAFC</Color>
    <Color x:Key="CardColor">#F8FAFC</Color>
    <Color x:Key="SurfaceInsetColor">#F1F5F9</Color>

    <!-- Text: Slate-800 neutral body copy, Slate-500 muted labels/SKU codes,
         Slate-400 disabled/inactive -->
    <Color x:Key="PrimaryTextColor">#1E293B</Color>
    <Color x:Key="SecondaryTextColor">#64748B</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>

    <!-- Border: Slate-200 hairline dividers/grids; DarkBorderColor for
         structural lines on dark surfaces (e.g. bottom nav top edge) -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="DarkBorderColor">#334155</Color>

    <!-- Disabled: Slate-300 -->
    <Color x:Key="DisabledColor">#CBD5E1</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessBackgroundColor">#E7F7EC</Color>

    <Color x:Key="WarningColor">#E59F1C</Color>
    <Color x:Key="WarningBackgroundColor">#FCF0DA</Color>

    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="ErrorBackgroundColor">#FBE7E7</Color>

    <!-- Chip / filter tag -->
    <Color x:Key="ChipBackground">#F1F5F9</Color>
    <Color x:Key="ChipText">#1E293B</Color>

    <!-- Popup overlay -->
    <Color x:Key="PopupBackground">#A0000000</Color>

    <Color x:Key="White">#FFFFFF</Color>

    <!-- ============================================================
         Legacy key names — kept so every existing StaticResource
         binding across the app resolves to the new palette above
         without needing to touch each binding site individually.
         New XAML should reference the canonical keys above directly.
         ============================================================ -->
    <Color x:Key="Primary">#0E1826</Color>
    <Color x:Key="PrimaryDark">#0E1826</Color>
    <Color x:Key="NavyBlue">#0E1826</Color>

    <Color x:Key="Accent">#C92027</Color>
    <Color x:Key="AccentLight">#E2949A</Color>

    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="CardBackground">#F8FAFC</Color>

    <!-- Product/section titles read as headline weight -> Primary navy,
         matching DESIGN.md's "Product Title ... #0E1826". -->
    <Color x:Key="TitleText">#0E1826</Color>
    <Color x:Key="BodyText">#64748B</Color>
    <Color x:Key="PriceText">#0E1826</Color>
    <Color x:Key="TextDark">#1E293B</Color>

    <Color x:Key="Divider">#E2E8F0</Color>
    <Color x:Key="Border">#E2E8F0</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessBackground">#E7F7EC</Color>

    <Color x:Key="Warning">#E59F1C</Color>
    <Color x:Key="WarningBackground">#FCF0DA</Color>

    <Color x:Key="Danger">#BA1A1A</Color>
    <Color x:Key="DangerBackground">#FBE7E7</Color>

    <Color x:Key="LinkColor">#C92027</Color>
    <Color x:Key="LightGray">#E2E8F0</Color>
</ResourceDictionary>
