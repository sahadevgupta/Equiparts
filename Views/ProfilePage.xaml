<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Equiparts.Controls"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:views="clr-namespace:Equiparts.Views"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    x:DataType="viewModels:ProfileViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBackground}">

    <views:BasePage.Resources>
        <!-- The app-wide default Border style (Styles.xaml) adds a drop shadow and a
             grey stroke to every Border. That's wrong for the flat cards/badges/chips
             used throughout this page, so it's cleared here rather than for the whole app. -->
        <Style TargetType="Border">
            <Setter Property="Shadow"
                    Value="{x:Null}"/>
        </Style>
    </views:BasePage.Resources>

    <views:BasePage.PageContent>

        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <!-- <Image Source="header_logo"
                   Margin="-2,0"/> -->
            <controls:AppHeaderView ShowSearchBar="False"
                                    HeaderTitle="Profile"
                                    MainViewHeight="150"
                                    CurveHeight="180"/>
            <ScrollView Grid.Row="1">

                <VerticalStackLayout
                    Padding="15,20"
                    Spacing="18">

                    <!-- Account Card -->

                    <Border
                        Padding="18"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 18">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="4">

                            <Border
                                Grid.RowSpan="3"
                                WidthRequest="60"
                                HeightRequest="60"
                                Padding="0"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 16"
                                VerticalOptions="Start">

                                <Label
                                    Text="{Binding Initials}"
                                    TextColor="{StaticResource Accent}"
                                    FontFamily="SpaceGroteskSemibold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>

                            </Border>

                            <Grid
                                Grid.Column="1"
                                ColumnDefinitions="*,Auto">

                                <Label
                                    Text="{Binding FullName}"
                                    StyleClass="SectionTitle"
                                    LineBreakMode="TailTruncation"/>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,4"
                                    BackgroundColor="{StaticResource WarningBackground}"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding AccountType}"
                                        TextColor="{StaticResource Warning}"
                                        FontFamily="SpaceGroteskSemibold"
                                        FontSize="11"
                                        CharacterSpacing="0.5"/>

                                </Border>

                            </Grid>

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Email}"
                                FontFamily="GeistRegular"
                                FontSize="14"
                                TextColor="{StaticResource BodyText}"
                                LineBreakMode="TailTruncation"/>

                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="{x:Static fontresources:FontAwesomeIcons.IdCard}"
                                    FontFamily="FontAwesome"
                                    FontSize="12"
                                    TextColor="{StaticResource BodyText}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Text="{Binding UserIdLabel}"
                                    FontFamily="GeistRegular"
                                    FontSize="13"
                                    TextColor="{StaticResource BodyText}"/>

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                    <!-- Orders & Activity -->

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="ORDERS &amp; ACTIVITY"
                            FontFamily="SpaceGroteskSemibold"
                            FontSize="12"
                            CharacterSpacing="0.6"
                            TextColor="{StaticResource BodyText}"
                            Margin="4,0,0,0"/>

                        <Border
                            Padding="0"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToOrdersCommand}"/>
                                    </Grid.GestureRecognizers>

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.Box}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="My Orders"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Track packages &amp; view past receipts"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        TextColor="{StaticResource BodyText}"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="16,0"
                                         IsVisible="True"/>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14"
                                      IsVisible="True">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAddressesCommand}"/>
                                    </Grid.GestureRecognizers>

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.MapMarkerAlt}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="Delivery Addresses"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Manage delivery locations &amp; defaults"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        TextColor="{StaticResource BodyText}"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="16,0"
                                         IsVisible="False"/>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14"
                                      IsVisible="False">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToWishlistCommand}"/>
                                    </Grid.GestureRecognizers>

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.Bookmark}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="Saved Items / Wishlist"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Parts &amp; equipment saved for later"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        TextColor="{StaticResource BodyText}"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                    <!-- Preferences -->

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="False">

                        <Label
                            Text="PREFERENCES"
                            FontFamily="SpaceGroteskSemibold"
                            FontSize="12"
                            CharacterSpacing="0.6"
                            TextColor="{StaticResource BodyText}"
                            Margin="4,0,0,0"/>

                        <Border
                            Padding="0"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14">

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.Bullhorn}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="Marketing &amp; Promotional Updates"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Exclusive discounts and product launches"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding MarketingUpdatesEnabled}"
                                        OnColor="{StaticResource Accent}"
                                        ThumbColor="White"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="16,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14">

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.Bell}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="App Notifications"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Order status &amp; dispatch alerts"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding AppNotificationsEnabled}"
                                        OnColor="{StaticResource Accent}"
                                        ThumbColor="White"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                    <!-- Account Security -->

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="ACCOUNT SECURITY"
                            FontFamily="SpaceGroteskSemibold"
                            FontSize="12"
                            CharacterSpacing="0.6"
                            TextColor="{StaticResource BodyText}"
                            Margin="4,0,0,0"/>

                        <Border
                            Padding="0"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14"
                                  Padding="16,14">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToChangePasswordCommand}"/>
                                </Grid.GestureRecognizers>

                                <Border
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    BackgroundColor="{StaticResource ChipBackground}"
                                    StrokeShape="Rectangle">

                                    <Label
                                        Text="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                        FontFamily="FontAwesome"
                                        FontSize="16"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="2">

                                    <Label
                                        Text="Change Password"
                                        FontFamily="SpaceGroteskSemibold"
                                        FontSize="16"
                                        TextColor="{StaticResource TitleText}"/>

                                    <Label
                                        Text="Update your account password"
                                        FontFamily="GeistRegular"
                                        FontSize="13"
                                        TextColor="{StaticResource BodyText}"/>

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                    FontFamily="FontAwesome"
                                    FontSize="14"
                                    TextColor="{StaticResource BodyText}"
                                    VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                    <!-- Support & Legal -->

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="SUPPORT &amp; LEGAL"
                            FontFamily="SpaceGroteskSemibold"
                            FontSize="12"
                            CharacterSpacing="0.6"
                            TextColor="{StaticResource BodyText}"
                            Margin="4,0,0,0"/>

                        <Border
                            Padding="0"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToHelpCommand}"/>
                                    </Grid.GestureRecognizers>

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.QuestionCircle}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="Help &amp; Support"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="FAQs, contact support, tickets"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        TextColor="{StaticResource BodyText}"
                                        VerticalOptions="Center"/>

                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="16,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14"
                                      Padding="16,14">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToTermsCommand}"/>
                                    </Grid.GestureRecognizers>

                                    <Border
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeShape="Rectangle">

                                        <Label
                                            Text="{x:Static fontresources:FontAwesomeIcons.ShieldAlt}"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{StaticResource Primary}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <Label
                                            Text="Terms &amp; Privacy"
                                            FontFamily="SpaceGroteskSemibold"
                                            FontSize="16"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            Text="Policies and user agreements"
                                            FontFamily="GeistRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="{x:Static fontresources:FontAwesomeIcons.ChevronRight}"
                                        FontFamily="FontAwesome"
                                        FontSize="14"
                                        TextColor="{StaticResource BodyText}"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                    <!-- Log Out -->

                    <Button
                        Text="LOG OUT"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Danger}"
                        FontFamily="SpaceGroteskSemibold"
                        FontSize="14"
                        CharacterSpacing="0.6"
                        HeightRequest="44"
                        Command="{Binding LogoutCommand}"/>

                    <Label
                        Text="{Binding AppVersionLabel}"
                        FontFamily="GeistRegular"
                        FontSize="12"
                        TextColor="{StaticResource BodyText}"
                        HorizontalOptions="Center"
                        Margin="0,-10,0,10"/>

                </VerticalStackLayout>

            </ScrollView>
        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
