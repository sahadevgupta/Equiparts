<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.CartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:models="clr-namespace:Equiparts.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:Equiparts.Views"
    x:DataType="viewModels:CartViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <views:BasePage.Resources>

        <!-- Flat cards for this page: the app-wide default Border style (Styles.xaml)
             adds a drop shadow, which reads wrong for the tight per-item breakdown
             chips and the circular stepper buttons used here. -->
        <Style TargetType="Border">
            <Setter Property="Shadow"
                    Value="{x:Null}"/>
        </Style>

        <Style x:Key="StepperButtonStyle"
               TargetType="Button">
            <Setter Property="WidthRequest"
                    Value="34"/>
            <Setter Property="HeightRequest"
                    Value="34"/>
            <Setter Property="CornerRadius"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="FontFamily"
                    Value="FontAwesome"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale"
                                        Value="0.9"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </views:BasePage.Resources>

    <views:BasePage.PageContent>
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto"
                  Padding="16,8"
                  BackgroundColor="{StaticResource NavyBlue}">
                <VerticalStackLayout
                    Spacing="4">

                    <HorizontalStackLayout Spacing="8">

                        <Label
                            Text="My Cart"
                            FontSize="24"
                            FontFamily="SpaceGroteskSemibold"
                            TextColor="White"/>

                        <Label
                            Text="{Binding ItemCountLabel,StringFormat='({0})'}"
                            FontSize="17"
                            TextColor="White"
                            VerticalOptions="End"/>

                    </HorizontalStackLayout>

                    <Label
                        Text="Review your items before checkout"
                        FontSize="14"
                        TextColor="White"/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Spacing="0"
                    IsVisible="{Binding Items.Count,Converter={toolkit:IntToBoolConverter}}">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearCartCommand}"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        FontFamily="FontAwesome"
                        Text="{x:Static fontresources:FontAwesomeIcons.Trash}"
                        FontSize="16"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                    <Label
                        Text="Clear Cart"
                        FontSize="13"
                        FontFamily="SpaceGroteskSemibold"
                        TextColor="White"
                        VerticalOptions="Center"/>

                </VerticalStackLayout>

            </Grid>

            <!-- Cart Items -->

            <CollectionView
                Grid.Row="1"
                Margin="15,10,15,10"
                ItemsSource="{Binding Items}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="15"
                        IsVisible="{Binding IsListEmpty}">

                        <Label
                            FontFamily="FontAwesome"
                            Text="{x:Static fontresources:FontAwesomeIcons.ShoppingCart}"
                            FontSize="80"
                            TextColor="{StaticResource ChipText}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Your cart is empty"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Browse products and add them to your cart."
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource MutedTextColor}"/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:CartItem">

                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout Spacing="10">

                                <Grid
                                    ColumnDefinitions="64,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- Product Image -->

                                    <Border
                                        HeightRequest="64"
                                        WidthRequest="64"
                                        Padding="0"
                                        Stroke="{StaticResource Border}"
                                        StrokeShape="Rectangle"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">

                                        <Image
                                            Aspect="AspectFill"
                                            Source="{Binding ImageUrl}"/>

                                    </Border>

                                    <!-- Name / Part number -->

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Start">

                                        <Label
                                            FontSize="16"
                                            FontFamily="SpaceGroteskSemibold"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource TitleText}"/>

                                        <Label
                                            FontSize="13"
                                            Text="{Binding PartNumber,StringFormat='Part No. {0}'}"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <!-- Remove -->

                                    <ImageButton
                                        Grid.Column="2"
                                        CornerRadius="0"
                                        HeightRequest="22"
                                        WidthRequest="22"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CartViewModel}}, Path=RemoveCommand}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsUpdating, Converter={toolkit:InvertedBoolConverter}}"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="FontAwesome"
                                                             Glyph="{x:Static fontresources:FontAwesomeIcons.Trash}"
                                                             Color="{StaticResource Danger}"/>
                                        </ImageButton.Source>
                                    </ImageButton>

                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">

                                    <!-- Price -->

                                    <VerticalStackLayout Spacing="2">

                                        <Label
                                            FontSize="20"
                                            FontFamily="SpaceGroteskSemibold"
                                            Text="{Binding LineSubTotal,StringFormat='₹ {0:N0}'}"
                                            TextColor="{StaticResource Accent}"/>

                                        <Label
                                            FontSize="12"
                                            Text="{Binding UnitPrice,StringFormat='(₹ {0:N2} each)'}"
                                            TextColor="{StaticResource BodyText}"/>

                                    </VerticalStackLayout>

                                    <!-- Quantity Stepper -->

                                    <HorizontalStackLayout
                                        Grid.Column="1"
                                        Spacing="14"
                                        VerticalOptions="Center">

                                        <Button
                                            Style="{StaticResource StepperButtonStyle}"
                                            Text="{x:Static fontresources:FontAwesomeIcons.Minus}"
                                            BackgroundColor="{StaticResource ChipBackground}"
                                            TextColor="{StaticResource ChipText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CartViewModel}}, Path=DecreaseCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsUpdating, Converter={toolkit:InvertedBoolConverter}}"/>

                                        <Label
                                            FontSize="16"
                                            FontFamily="SpaceGroteskSemibold"
                                            Text="{Binding Quantity}"
                                            TextColor="{StaticResource TitleText}"
                                            VerticalOptions="Center"
                                            WidthRequest="18"
                                            HorizontalTextAlignment="Center"/>

                                        <Button
                                            Style="{StaticResource StepperButtonStyle}"
                                            Text="{x:Static fontresources:FontAwesomeIcons.Plus}"
                                            BackgroundColor="{StaticResource Accent}"
                                            TextColor="White"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CartViewModel}}, Path=IncreaseCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsUpdating, Converter={toolkit:InvertedBoolConverter}}"/>

                                    </HorizontalStackLayout>

                                </Grid>

                                <!-- Per-item breakdown (single line; full split lives in the bottom bar) -->

                                <Border
                                    Padding="10,6"
                                    BackgroundColor="{StaticResource WarningBackground}"
                                    Stroke="Transparent"
                                    StrokeShape="Rectangle">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            FontSize="12"
                                            VerticalOptions="Center"
                                            TextColor="{StaticResource BodyText}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding GstRatePercent,StringFormat='+ GST {0:0.##}%  '}"/>
                                                    <Span Text="{Binding LineTax,StringFormat='₹ {0:N2}'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label
                                            Grid.Column="1"
                                            FontSize="14"
                                            FontFamily="SpaceGroteskSemibold"
                                            VerticalOptions="Center"
                                            Text="{Binding LineTotal,StringFormat='₹ {0:N2}'}"
                                            TextColor="{StaticResource TitleText}"/>

                                    </Grid>

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Bottom Summary: one-row checkout bar -->

            <Border
                IsVisible="{Binding Items.Count,Converter={toolkit:IntToBoolConverter}}"
                Grid.Row="2"
                BackgroundColor="{StaticResource CardBackground}"
                Padding="16,10,16,12"
                Stroke="{StaticResource Border}"
                StrokeShape="Rectangle">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">

                    <VerticalStackLayout Spacing="0"
                                         VerticalOptions="Center">

                        <Label
                            FontSize="12"
                            TextColor="{StaticResource BodyText}"
                            Text="{Binding TaxTotal,StringFormat='Total (incl. GST ₹ {0:N2})'}"/>

                        <Label
                            FontSize="22"
                            FontFamily="SpaceGroteskSemibold"
                            TextColor="{StaticResource Accent}"
                            Text="{Binding GrandTotal,StringFormat='₹ {0:N2}'}"/>

                        <Label
                            FontSize="11"
                            TextColor="{StaticResource Success}"
                            IsVisible="{Binding HasDiscount}"
                            Text="{Binding DiscountAmount,StringFormat='You save ₹ {0:N2}'}"/>

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        HeightRequest="48"
                        Padding="20,0"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource Accent}"
                        Stroke="Transparent"
                        StrokeShape="Rectangle">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckoutCommand}"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                Text="Checkout"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                VerticalOptions="Center"/>

                            <Label
                                FontFamily="FontAwesome"
                                Text="{x:Static fontresources:FontAwesomeIcons.ArrowRight}"
                                FontSize="14"
                                TextColor="White"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </Border>

                </Grid>

            </Border>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
