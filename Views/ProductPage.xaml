<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ProductPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:controls="clr-namespace:Equiparts.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:models="clr-namespace:Equiparts.Models"
    xmlns:views="clr-namespace:Equiparts.Views"
    x:DataType="viewModels:ProductViewModel"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource PageBackground}">

    <views:BasePage.Resources>
        <!-- The app-wide default Border style (Styles.xaml) adds a drop shadow and a
             grey stroke to every Border. That's wrong for the flat badges/chips/dots
             used throughout this page, so it's cleared here rather than for the whole app. -->
        <Style TargetType="Border">
            <Setter Property="Shadow"
                    Value="{x:Null}"/>
        </Style>
    </views:BasePage.Resources>

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label VerticalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="19"
                   TextColor="White"
                   LineBreakMode="TailTruncation"
                   Text="{Binding Title}"/>

            <Border Grid.Column="1"
                    WidthRequest="38"
                    HeightRequest="38"
                    Padding="0"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Stroke="#3FFFFFFF"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 10"
                    Margin="0,0,10,0"
                    IsVisible="False">

                <Label
                    FontFamily="FontAwesome"
                    Text="{x:Static fontresources:FontAwesomeIcons.Filter}"
                    FontSize="16"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Border>


        </Grid>
    </Shell.TitleView>

    <views:BasePage.PageContent>
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="0">

            <!-- Header -->
            <!-- Search -->
            <VerticalStackLayout BackgroundColor="{StaticResource NavyBlue}">
                <Border BackgroundColor="White"
                        Padding="0"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 6"
                        x:Name="EntryBorder"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Margin="10,5,10,15">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Padding="12,0">

                        <Label Grid.Column="0"
                               FontFamily="FontAwesome"
                               Text="{x:Static fontresources:FontAwesomeIcons.Search}"
                               FontSize="18"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                        <controls:BorderlessEntry Grid.Column="1"
                                                  BackgroundColor="Transparent"
                                                  Placeholder="Search products..."
                                                  PlaceholderColor="Gray"
                                                  Text="{Binding SearchText}"
                                                  HorizontalOptions="Fill"
                                                  VerticalTextAlignment="Center"
                                                  VerticalOptions="Center"
                                                  x:Name="UserStoppedTypingEntry">

                            <controls:BorderlessEntry.Behaviors>
                                <toolkit:UserStoppedTypingBehavior
                                    BindingContext="{Binding Path=BindingContext, Source={x:Reference UserStoppedTypingEntry}, x:DataType=controls:BorderlessEntry}"
                                    StoppedTypingTimeThreshold="500"
                                    MinimumLengthThreshold="3"
                                    ShouldDismissKeyboardAutomatically="False"
                                    Command="{Binding SearchCommand}"/>
                            </controls:BorderlessEntry.Behaviors>

                        </controls:BorderlessEntry>

                        <ImageButton Grid.Column="2"
                                     IsVisible="{Binding SearchText,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                     BackgroundColor="Transparent"
                                     Command="{Binding ClearSearchCommand}">

                            <ImageButton.Source>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Times}"
                                                 Size="18"
                                                 Color="Gray"/>
                            </ImageButton.Source>

                        </ImageButton>

                        <!-- <Label Grid.Column="3"
                               FontFamily="FontAwesome"
                               Text="{x:Static fontresources:FontAwesomeIcons.Barcode}"
                               FontSize="18"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                        <Label Grid.Column="4"
                               FontFamily="FontAwesome"
                               Text="{x:Static fontresources:FontAwesomeIcons.Microphone}"
                               FontSize="18"
                               TextColor="Gray"
                               VerticalOptions="Center"/> -->

                    </Grid>

                </Border>

            </VerticalStackLayout>
            <!-- Content -->
            <Grid Grid.Row="2">

                <RefreshView IsRefreshing="{Binding IsRefreshing}"
                             Command="{Binding RefreshCommand}">

                    <CollectionView ItemsSource="{Binding Products}"
                                    SelectionMode="None"
                                    Margin="0,10,0,0"
                                    RemainingItemsThreshold="3"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                        <CollectionView.EmptyView>

                            <VerticalStackLayout
                                IsVisible="{Binding IsBusy,Converter={toolkit:InvertedBoolConverter}}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="12">

                                <Label
                                    Text="{Binding HasError,Converter={toolkit:BoolToObjectConverter TrueObject='Something went wrong',FalseObject='No products found'}}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"/>

                                <Label
                                    Text="{Binding HasError,Converter={toolkit:BoolToObjectConverter TrueObject='Please check your connection and try again.',FalseObject='Try a different search or check back later.'}}"
                                    TextColor="Gray"
                                    HorizontalTextAlignment="Center"/>

                                <Button
                                    IsVisible="{Binding HasError}"
                                    Text="Retry"
                                    WidthRequest="140"
                                    Command="{Binding LoadCommand}"/>

                            </VerticalStackLayout>

                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>

                            <DataTemplate x:DataType="models:Product">

                                <Border
                                    Margin="10,6"
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductViewModel}}, Path=OpenProductCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsOutOfStock}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="#F2F2F2"/>
                                            <Setter Property="Opacity"
                                                    Value="0.6"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="86,*"
                                          ColumnSpacing="12">

                                        <!-- Thumbnail -->
                                        <Grid RowDefinitions="Auto"
                                              VerticalOptions="Start">

                                            <Border
                                                Padding="0"
                                                HeightRequest="86"
                                                WidthRequest="86"
                                                BackgroundColor="White"
                                                Stroke="{StaticResource Border}"
                                                StrokeShape="RoundRectangle 14">

                                                <ffimageloading:CachedImage
                                                    Aspect="AspectFit"
                                                    Source="{Binding Image,FallbackValue='backhoe_loader',TargetNullValue='backhoe_loader'}"/>

                                            </Border>

                                            <Border
                                                Margin="4"
                                                Padding="6,2"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource Accent}"
                                                StrokeShape="RoundRectangle 4"
                                                IsVisible="{Binding BrandName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}">

                                                <Label
                                                    FontSize="9"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    Text="OEM"/>

                                            </Border>

                                        </Grid>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4">

                                            <!-- Tier/Brand chip + Stock -->
                                            <Grid ColumnDefinitions="*,Auto">

                                                <Border
                                                    HorizontalOptions="Start"
                                                    Padding="8,2"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource ChipBackground}"
                                                    StrokeShape="RoundRectangle 20"
                                                    IsVisible="{Binding HasBrandInfo}">

                                                    <HorizontalStackLayout Spacing="4">

                                                        <Label
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            TextTransform="Uppercase"
                                                            TextColor="{StaticResource ChipText}"
                                                            IsVisible="{Binding TierName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                                            Text="{Binding TierName}"/>

                                                        <Label
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            TextTransform="Uppercase"
                                                            TextColor="{StaticResource ChipText}"
                                                            IsVisible="{Binding BrandName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                                            Text="{Binding BrandName}"/>

                                                    </HorizontalStackLayout>

                                                </Border>

                                                <!-- In Stock -->
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource SuccessBackground}"
                                                    StrokeShape="RoundRectangle 20"
                                                    IsVisible="{Binding IsInStock}">

                                                    <Label
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource Success}"
                                                        Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                                </Border>

                                                <!-- Out Of Stock -->
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource WarningBackground}"
                                                    StrokeShape="RoundRectangle 20"
                                                    IsVisible="{Binding IsOutOfStock}">

                                                    <Label
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource Warning}"
                                                        Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                                </Border>

                                                <!-- Low Stock -->
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource DangerBackground}"
                                                    StrokeShape="RoundRectangle 20"
                                                    IsVisible="{Binding IsLowStock}">

                                                    <Label
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource Danger}"
                                                        Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                                </Border>

                                            </Grid>

                                            <!-- Name -->
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Name}"/>

                                            <!-- Part No / SKU -->
                                            <Label
                                                FontSize="12"
                                                TextColor="Gray"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding PartNumber,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                                Text="{Binding PartNumber,StringFormat='Part No: {0}'}"/>

                                            <Label
                                                FontSize="11"
                                                Opacity="0.7"
                                                TextColor="Gray"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding RequiresEnquiry}"
                                                Text="{Binding Sku,StringFormat='SKU: {0}'}"/>

                                            <BoxView HeightRequest="1"
                                                     Margin="0,4"
                                                     Color="{StaticResource Border}"
                                                     IsVisible="{Binding RequiresEnquiry}"/>

                                            <!-- Pricing / CTA -->
                                            <Grid ColumnDefinitions="*,Auto"
                                                  Margin="0,2,0,0">

                                                <VerticalStackLayout Spacing="1"
                                                                     VerticalOptions="Center"
                                                                     IsVisible="{Binding RequiresEnquiry}">

                                                    <Label
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextTransform="Uppercase"
                                                        CharacterSpacing="0.5"
                                                        TextColor="Gray"
                                                        Text="Pricing"/>

                                                    <Label
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource Accent}"
                                                        Text="₹ Contact Quote"/>

                                                </VerticalStackLayout>

                                                <VerticalStackLayout Spacing="1"
                                                                     VerticalOptions="Center"
                                                                     IsVisible="{Binding RequiresEnquiry,Converter={toolkit:InvertedBoolConverter}}">

                                                    <HorizontalStackLayout Spacing="6">

                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="18"
                                                            VerticalOptions="Center"
                                                            Text="{Binding Price,StringFormat='₹ {0:F0}'}"
                                                            TextColor="{StaticResource Accent}"/>

                                                        <Label
                                                            VerticalOptions="Center"
                                                            FontSize="13"
                                                            TextDecorations="Strikethrough"
                                                            TextColor="Gray"
                                                            IsVisible="{Binding HasDiscount}"
                                                            Text="{Binding Mrp,StringFormat='₹ {0:F0}'}"/>

                                                    </HorizontalStackLayout>

                                                    <Label
                                                        FontSize="11"
                                                        TextColor="Gray"
                                                        Opacity="0.8"
                                                        Text="+ 18% GST Excl."/>

                                                </VerticalStackLayout>

                                                <Button
                                                    Grid.Column="1"
                                                    Padding="12,0"
                                                    HeightRequest="38"
                                                    CornerRadius="10"
                                                    FontSize="13"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{StaticResource Accent}"
                                                    TextColor="White"
                                                    Text="Add To Cart"
                                                    IsVisible="{Binding CanAddToCart}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductViewModel}}, Path=AddToCartCommand}"
                                                    CommandParameter="{Binding .}">

                                                    <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesome"
                                                                         Glyph="{x:Static fontresources:FontAwesomeIcons.Plus}"
                                                                         Size="14"
                                                                         Color="White"/>
                                                    </Button.ImageSource>

                                                </Button>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <ActivityIndicator
                                Margin="0,10,0,70"
                                IsRunning="{Binding IsLoadingMore}"
                                IsVisible="{Binding IsLoadingMore}"
                                Color="{StaticResource Accent}"/>
                        </CollectionView.Footer>

                    </CollectionView>

                </RefreshView>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Accent}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Grid>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
