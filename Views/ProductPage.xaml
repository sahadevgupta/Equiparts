<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ProductPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:models="clr-namespace:Equiparts.Models"
    xmlns:views="clr-namespace:Equiparts.Views"
    x:DataType="viewModels:ProductViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource PageBackground}">

    <views:BasePage.PageContent>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Header -->
            <!-- <Image Source="header_logo"
                   Margin="-2,0"/>

            <Label Text="{Binding DebugInfo}"
                   FontSize="11"
                   TextColor="Red"
                   BackgroundColor="Yellow"
                   Padding="4"
                   Grid.Row="1"/> -->

            <!-- Search -->
            <Border Grid.Row="2"
                    Margin="15"
                    Padding="12"
                    Stroke="{StaticResource Border}"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12">

                <Grid ColumnDefinitions="30,*,Auto">

                    <Image Source="search.png"
                           HeightRequest="18"
                           WidthRequest="18"/>

                    <Entry Grid.Column="1"
                           Placeholder="Search products..."
                           PlaceholderColor="Gray"
                           Text="{Binding SearchText}">

                        <Entry.Behaviors>
                            <toolkit:UserStoppedTypingBehavior
                                StoppedTypingTimeThreshold="500"
                                MinimumLengthThreshold="0"
                                ShouldDismissKeyboardAutomatically="False"
                                Command="{Binding SearchCommand}"/>
                        </Entry.Behaviors>

                    </Entry>

                    <ImageButton Grid.Column="2"
                                 IsVisible="{Binding SearchText,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                 BackgroundColor="Transparent"
                                 Command="{Binding ClearSearchCommand}">

                        <ImageButton.Source>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="{x:Static fontresources:FontAwesomeIcons.Times}"
                                             Size="18"
                                             Color="Gray"/>
                        </ImageButton.Source>

                    </ImageButton>

                </Grid>

            </Border>

            <!-- Content -->
            <Grid Grid.Row="3">

                <RefreshView IsRefreshing="{Binding IsRefreshing}"
                             Command="{Binding RefreshCommand}">

                    <CollectionView ItemsSource="{Binding Products}"
                                    SelectionMode="None"
                                    Margin="15,0,15,15"
                                    RemainingItemsThreshold="3"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                        <CollectionView.EmptyView>

                            <VerticalStackLayout
                                IsVisible="{Binding IsBusy,Converter={toolkit:InvertedBoolConverter}}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="12">

                                <Label
                                    Text="{Binding HasError,Converter={toolkit:BoolToObjectConverter TrueObject='Something went wrong',FalseObject='No products found'}}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"/>

                                <Label
                                    Text="{Binding HasError,Converter={toolkit:BoolToObjectConverter TrueObject='Please check your connection and try again.',FalseObject='Try a different search or check back later.'}}"
                                    TextColor="Gray"
                                    HorizontalTextAlignment="Center"/>

                                <Button
                                    IsVisible="{Binding HasError}"
                                    Text="Retry"
                                    WidthRequest="140"
                                    Command="{Binding LoadCommand}"/>

                            </VerticalStackLayout>

                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>

                            <DataTemplate x:DataType="models:Product">

                                <Border
                                    Margin="0,6"
                                    Padding="12"
                                    BackgroundColor="White"
                                    Stroke="{StaticResource Border}"
                                    StrokeShape="RoundRectangle 16">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductViewModel}}, Path=OpenProductCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="90,*"
                                          RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="4">

                                        <ffimageloading:CachedImage
                                            Grid.RowSpan="3"
                                            Aspect="AspectFit"
                                            HeightRequest="80"
                                            WidthRequest="80"
                                            Source="{Binding Image,FallbackValue='backhoe_loader',TargetNullValue='backhoe_loader'}"/>

                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"/>

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Opacity="0.7"
                                            IsVisible="{Binding Description,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                            Text="{Binding Description}"/>

                                        <Grid Grid.Row="2"
                                              Grid.Column="1"
                                              ColumnDefinitions="*,Auto">

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                VerticalOptions="Center"
                                                Text="{Binding Price,StringFormat='₹ {0:F0}'}"
                                                TextColor="{StaticResource Accent}"/>

                                            <Button
                                                Grid.Column="1"
                                                Padding="12,0"
                                                HeightRequest="36"
                                                CornerRadius="10"
                                                FontSize="13"
                                                BackgroundColor="{StaticResource Accent}"
                                                TextColor="White"
                                                Text="Add To Cart"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ProductViewModel}}, Path=AddToCartCommand}"
                                                CommandParameter="{Binding .}"/>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <ActivityIndicator
                                Margin="0,10"
                                IsRunning="{Binding IsLoadingMore}"
                                IsVisible="{Binding IsLoadingMore}"
                                Color="{StaticResource Accent}"/>
                        </CollectionView.Footer>

                    </CollectionView>

                </RefreshView>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Accent}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Grid>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
