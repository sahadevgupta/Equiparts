<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Equiparts.Controls"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:views="clr-namespace:Equiparts.Views"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    x:DataType="viewModels:ChangePasswordViewModel"
    Title="Change Password"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource PageBackground}">

    <views:BasePage.Resources>
        <!-- The app-wide default Border style (Styles.xaml) adds a drop shadow and a
             grey stroke to every Border. That's wrong for the flat card/icon-badge used
             on this page, so it's cleared here rather than for the whole app. -->
        <Style TargetType="Border">
            <Setter Property="Shadow"
                    Value="{x:Null}"/>
        </Style>
    </views:BasePage.Resources>

    <views:BasePage.PageContent>
        <ScrollView>

            <VerticalStackLayout Padding="20,24"
                                 Spacing="20">

                <!-- Icon badge -->
                <Border WidthRequest="64"
                        HeightRequest="64"
                        Padding="0"
                        BackgroundColor="{StaticResource ChipBackground}"
                        StrokeShape="Rectangle"
                        HorizontalOptions="Center">

                    <Label Text="{x:Static fontresources:FontAwesomeIcons.Lock}"
                           FontFamily="FontAwesome"
                           FontSize="24"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Update your password"
                           FontFamily="SpaceGroteskSemibold"
                           FontSize="19"
                           TextColor="{StaticResource TitleText}"
                           HorizontalOptions="Center"/>

                    <Label Text="Choose a strong password you don't use elsewhere"
                           FontFamily="GeistRegular"
                           FontSize="13"
                           TextColor="{StaticResource BodyText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Form card -->
                <Border Padding="18"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource Border}"
                        StrokeShape="Rectangle">

                    <VerticalStackLayout Spacing="16">

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}"
                               FontSize="13"
                               IsVisible="{Binding HasError}"/>

                        <Label Text="{Binding SuccessMessage}"
                               TextColor="{StaticResource Success}"
                               FontSize="13"
                               IsVisible="{Binding HasSuccess}"/>

                        <controls:ExtendedEntry Title="Current Password"
                                                 Text="{Binding CurrentPassword}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Enter current password"
                                                 IsPassword="True"/>

                        <controls:ExtendedEntry Title="New Password"
                                                 Text="{Binding NewPassword}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Enter new password"
                                                 IsPassword="True"/>

                        <controls:ExtendedEntry Title="Confirm New Password"
                                                 Text="{Binding ConfirmNewPassword}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Re-enter new password"
                                                 IsPassword="True"/>

                    </VerticalStackLayout>

                </Border>

                <!-- Update button -->
                <Border BackgroundColor="{StaticResource Primary}"
                        Stroke="Transparent"
                        HeightRequest="54">
                    <Border.StrokeShape>
                        <Rectangle/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePasswordCommand}"/>
                    </Border.GestureRecognizers>

                    <Label Text="Update Password"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Accent}"
                                   HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </ScrollView>
    </views:BasePage.PageContent>

</views:BasePage>
