<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:models="clr-namespace:Equiparts.Models"
    xmlns:views="clr-namespace:Equiparts.Views"
    x:DataType="viewModels:ProductDetailViewModel"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource PageBackground}"
    Title="{Binding Product.Name,FallbackValue='Product Details'}">

    <views:BasePage.Resources>
        <!-- The app-wide default Border style (Styles.xaml) adds a drop shadow and a
             grey stroke to every Border. That's wrong for the flat badges/chips/dots
             used throughout this page, so it's cleared here rather than for the whole app. -->
        <Style TargetType="Border">
            <Setter Property="Shadow" Value="{x:Null}"/>
        </Style>
    </views:BasePage.Resources>

    <!-- Header -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="16">

            <VerticalStackLayout Grid.Column="0"
                                 VerticalOptions="Center"
                                 Spacing="1">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    TextColor="White"
                    LineBreakMode="TailTruncation"
                    Text="Product Details"/>

                <Label
                    FontSize="11"
                    TextColor="White"
                    Opacity="0.65"
                    LineBreakMode="TailTruncation"
                    IsVisible="{Binding Product.Sku,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                    Text="{Binding Product.Sku,StringFormat='SKU: {0}'}"/>

            </VerticalStackLayout>

            <ImageButton
                Grid.Column="1"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                Command="{Binding ShareCommand}">

                <ImageButton.Source>
                    <FontImageSource FontFamily="FontAwesome"
                                     Glyph="{x:Static fontresources:FontAwesomeIcons.Share}"
                                     Size="18"
                                     Color="White"/>
                </ImageButton.Source>

            </ImageButton>

            <Grid Grid.Column="2"
                  VerticalOptions="Center"
                  WidthRequest="30"
                  HeightRequest="30">

                <ImageButton
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <ImageButton.Source>
                        <FontImageSource FontFamily="FontAwesome"
                                         Glyph="{x:Static fontresources:FontAwesomeIcons.ShoppingCart}"
                                         Size="18"
                                         Color="White"/>
                    </ImageButton.Source>

                </ImageButton>

                <Border
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-4,-6,0"
                    Padding="4,1"
                    MinimumWidthRequest="16"
                    BackgroundColor="{StaticResource Accent}"
                    StrokeThickness="0"
                    StrokeShape="Rectangle"
                    IsVisible="{Binding HasCartItems}">

                    <Label
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        Text="{Binding CartItemCount}"/>

                </Border>

            </Grid>

        </Grid>
    </Shell.TitleView>

    <views:BasePage.PageContent>
        <Grid RowDefinitions="*">

            <!-- Not found / error state -->
            <VerticalStackLayout
                IsVisible="{Binding HasError}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="12">

                <Label
                    Text="Product not found"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="We couldn't load this product's details."
                    TextColor="{StaticResource MutedTextColor}"
                    HorizontalTextAlignment="Center"/>

                <Button
                    Text="Go Back"
                    WidthRequest="140"
                    Command="{Binding GoBackCommand}"/>

            </VerticalStackLayout>

            <!-- Details -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding HasError,Converter={toolkit:InvertedBoolConverter}}">

                <ScrollView BindingContext="{Binding Product}"
                            x:DataType="models:Product">

                    <VerticalStackLayout Padding="15"
                                         Spacing="14">

                        <!-- Image card -->
                        <Border
                            Padding="14"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout Spacing="12">

                                <!-- Trust badges -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Border
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        Padding="10,5"
                                        BackgroundColor="{StaticResource SuccessBackground}"
                                        StrokeThickness="0"
                                        StrokeShape="Rectangle">

                                        <HorizontalStackLayout Spacing="5">

                                            <Label
                                                FontFamily="FontAwesome"
                                                FontSize="12"
                                                VerticalOptions="Center"
                                                TextColor="{StaticResource Success}"
                                                Text="{x:Static fontresources:FontAwesomeIcons.CheckCircle}"/>

                                            <Label
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Success}"
                                                Text="Genuine Verified"/>

                                        </HorizontalStackLayout>

                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Padding="10,5"
                                        BackgroundColor="{StaticResource Primary}"
                                        Stroke="{StaticResource TertiaryColor}"
                                        StrokeThickness="1"
                                        StrokeShape="Rectangle"
                                        IsVisible="{Binding BrandName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}">

                                        <Label
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextTransform="Uppercase"
                                            TextColor="{StaticResource TertiaryColor}"
                                            Text="{Binding BrandName,StringFormat='{0} OEM'}"/>

                                    </Border>

                                </Grid>

                                <!-- Image -->
                                <Grid>

                                    <Border
                                        Padding="0"
                                        HeightRequest="260"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        StrokeShape="Rectangle">

                                        <ffimageloading:CachedImage
                                            Aspect="AspectFit"
                                            Source="{Binding Image,FallbackValue='backhoe_loader',TargetNullValue='backhoe_loader'}"/>

                                    </Border>

                                    <Border
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="10"
                                        Padding="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#66000000"
                                        StrokeThickness="0"
                                        StrokeShape="Rectangle">

                                        <Label
                                            FontFamily="FontAwesome"
                                            FontSize="14"
                                            TextColor="White"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Text="{x:Static fontresources:FontAwesomeIcons.SearchPlus}"/>

                                    </Border>

                                    <Border
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="10"
                                        Padding="9,5"
                                        BackgroundColor="#CC1A1A1A"
                                        StrokeThickness="0"
                                        StrokeShape="Rectangle">

                                        <HorizontalStackLayout Spacing="6">

                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                CornerRadius="0"
                                                VerticalOptions="Center"
                                                Color="{StaticResource Success}"/>

                                            <Label
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                Text="100% Authentic OEM"/>

                                        </HorizontalStackLayout>

                                    </Border>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Info card -->
                        <Border
                            Padding="16"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource Border}"
                            StrokeShape="Rectangle">

                            <VerticalStackLayout Spacing="12">

                                <!-- Brand chip / category + Stock status -->
                                <Grid ColumnDefinitions="*,Auto">

                                    <HorizontalStackLayout Grid.Column="0"
                                                            Spacing="8"
                                                            VerticalOptions="Center">

                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{StaticResource ChipBackground}"
                                            StrokeThickness="0"
                                            StrokeShape="Rectangle"
                                            IsVisible="{Binding BrandName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}">

                                            <Label
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TitleText}"
                                                Text="{Binding BrandName}"/>

                                        </Border>

                                        <Label
                                            FontSize="12"
                                            TextColor="{StaticResource MutedTextColor}"
                                            TextTransform="Uppercase"
                                            CharacterSpacing="0.5"
                                            LineBreakMode="TailTruncation"
                                            IsVisible="{Binding CategoryName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                            Text="{Binding CategoryName}"/>

                                    </HorizontalStackLayout>

                                    <!-- In Stock -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        BackgroundColor="{StaticResource SuccessBackground}"
                                        StrokeShape="Rectangle"
                                        StrokeThickness="0"
                                        IsVisible="{Binding IsInStock}">

                                        <Label
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Success}"
                                            Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                    </Border>

                                    <!-- Out Of Stock -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        BackgroundColor="{StaticResource WarningBackground}"
                                        StrokeShape="Rectangle"
                                        StrokeThickness="0"
                                        IsVisible="{Binding IsOutOfStock}">

                                        <Label
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Warning}"
                                            Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                    </Border>

                                    <!-- Low Stock -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        BackgroundColor="{StaticResource DangerBackground}"
                                        StrokeShape="Rectangle"
                                        StrokeThickness="0"
                                        IsVisible="{Binding IsLowStock}">

                                        <Label
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Danger}"
                                            Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                                    </Border>

                                </Grid>

                                <!-- Name -->
                                <Label
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    Text="{Binding Name}"/>

                                <!-- Part Number -->
                                <HorizontalStackLayout
                                    Spacing="8"
                                    IsVisible="{Binding PartNumber,Converter={toolkit:IsStringNotNullOrEmptyConverter}}">

                                    <Label
                                        FontSize="13"
                                        TextColor="{StaticResource MutedTextColor}"
                                        VerticalOptions="Center"
                                        Text="Part Number:"/>

                                    <Border
                                        Padding="8,3"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        StrokeThickness="0"
                                        StrokeShape="Rectangle">

                                        <Label
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TitleText}"
                                            Text="{Binding PartNumber}"/>

                                    </Border>

                                </HorizontalStackLayout>

                                <!-- Rating -->
                                <HorizontalStackLayout
                                    Spacing="6"
                                    IsVisible="{Binding HasRating}">

                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding AverageRating,StringFormat='★ {0:F1}'}"
                                        TextColor="{StaticResource Accent}"/>

                                    <Label
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource MutedTextColor}"
                                        Text="{Binding ReviewCount,StringFormat='({0} reviews)'}"/>

                                </HorizontalStackLayout>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Border}"/>

                                <!-- Pricing -->
                                <Border
                                    Padding="14"
                                    BackgroundColor="{StaticResource PageBackground}"
                                    StrokeThickness="0"
                                    StrokeShape="Rectangle">

                                    <VerticalStackLayout Spacing="8">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <Label
                                                Grid.Column="0"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource MutedTextColor}"
                                                TextTransform="Uppercase"
                                                CharacterSpacing="0.5"
                                                VerticalOptions="Center"
                                                Text="Industrial Price"/>

                                            <Border
                                                Grid.Column="1"
                                                Padding="9,3"
                                                BackgroundColor="Transparent"
                                                Stroke="{StaticResource Accent}"
                                                StrokeThickness="1"
                                                StrokeShape="Rectangle"
                                                IsVisible="{Binding TierName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}">

                                                <Label
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource Accent}"
                                                    Text="{Binding TierName,StringFormat='{0} Tier'}"/>

                                            </Border>

                                        </Grid>

                                        <!-- Priced -->
                                        <HorizontalStackLayout Spacing="10"
                                                               IsVisible="{Binding RequiresEnquiry,Converter={toolkit:InvertedBoolConverter}}">

                                            <Label
                                                FontSize="26"
                                                FontAttributes="Bold"
                                                Text="{Binding Price,StringFormat='₹ {0:F0}'}"
                                                TextColor="{StaticResource Accent}"/>

                                            <Label
                                                VerticalOptions="Center"
                                                FontSize="16"
                                                TextDecorations="Strikethrough"
                                                TextColor="{StaticResource MutedTextColor}"
                                                IsVisible="{Binding HasDiscount}"
                                                Text="{Binding Mrp,StringFormat='₹ {0:F0}'}"/>

                                            <Label
                                                VerticalOptions="Center"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Success}"
                                                IsVisible="{Binding HasDiscount}"
                                                Text="{Binding DiscountPercent,StringFormat='{0:F0}% off'}"/>

                                        </HorizontalStackLayout>

                                        <!-- Contact Quote -->
                                        <Label
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TitleText}"
                                            IsVisible="{Binding RequiresEnquiry}"
                                            Text="Price on Request"/>

                                    </VerticalStackLayout>

                                </Border>

                                <!-- Description -->
                                <Label
                                    StyleClass="SectionTitle"
                                    Text="Description"
                                    IsVisible="{Binding Description,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

                                <Label
                                    FontSize="14"
                                    Opacity="0.8"
                                    Text="{Binding Description}"
                                    IsVisible="{Binding Description,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </ScrollView>

                <!-- Fixed action bar -->
                <VerticalStackLayout Grid.Row="1"
                                     BackgroundColor="{StaticResource CardBackground}"
                                     Padding="15,12"
                                     Spacing="0"
                                     BindingContext="{Binding Product}"
                                     x:DataType="models:Product">

                    <BoxView HeightRequest="1"
                             Margin="-15,0,-15,12"
                             Color="{StaticResource Border}"/>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <!-- Notify Stock -->
                        <Button
                            Grid.Column="0"
                            HeightRequest="52"
                            Text="Notify Stock"
                            BackgroundColor="White"
                            TextColor="{StaticResource TitleText}"
                            BorderColor="{StaticResource Border}"
                            BorderWidth="1"
                            CornerRadius="0"
                            IsVisible="{Binding IsOutOfStock}"
                            Command="{Binding BindingContext.NotifyStockCommand, Source={RelativeSource AncestorType={x:Type views:ProductDetailPage}}}">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Bell}"
                                                 Size="15"
                                                 Color="{StaticResource TitleText}"/>
                            </Button.ImageSource>

                        </Button>

                        <!-- Request Quote -->
                        <Button
                            Grid.Column="1"
                            HeightRequest="52"
                            Text="Request Quote"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="White"
                            CornerRadius="0"
                            IsVisible="{Binding RequiresEnquiry}"
                            Command="{Binding BindingContext.EnquireCommand, Source={RelativeSource AncestorType={x:Type views:ProductDetailPage}}}">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Comment}"
                                                 Size="15"
                                                 Color="White"/>
                            </Button.ImageSource>

                        </Button>

                        <!-- Add To Cart -->
                        <Button
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HeightRequest="52"
                            Text="Add To Cart"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="White"
                            CornerRadius="0"
                            IsVisible="{Binding CanAddToCart}"
                            Command="{Binding BindingContext.AddToCartCommand, Source={RelativeSource AncestorType={x:Type views:ProductDetailPage}}}">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="{x:Static fontresources:FontAwesomeIcons.Plus}"
                                                 Size="16"
                                                 Color="White"/>
                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </VerticalStackLayout>

            </Grid>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
