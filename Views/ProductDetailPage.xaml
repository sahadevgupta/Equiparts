<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:models="clr-namespace:Equiparts.Models"
    xmlns:views="clr-namespace:Equiparts.Views"
    x:DataType="viewModels:ProductDetailViewModel"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource PageBackground}"
    Title="{Binding Product.Name,FallbackValue='Product Details'}">

    <views:BasePage.PageContent>
        <Grid RowDefinitions="Auto,*">

            <!-- Header -->
            <!-- <Grid Padding="15,15,15,10"
                  ColumnDefinitions="Auto,*">

                <ImageButton
                    BackgroundColor="Transparent"
                    Command="{Binding GoBackCommand}">

                    <ImageButton.Source>
                        <FontImageSource FontFamily="FontAwesome"
                                         Glyph="{x:Static fontresources:FontAwesomeIcons.ArrowLeft}"
                                         Size="20"
                                         Color="{StaticResource TitleText}"/>
                    </ImageButton.Source>

                </ImageButton>

                <Label
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="18"
                    LineBreakMode="TailTruncation"
                    Text="{Binding Product.Name,FallbackValue='Product Details'}"/>

            </Grid> -->

            <!-- Not found / error state -->
            <VerticalStackLayout
                Grid.Row="1"
                IsVisible="{Binding HasError}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="12">

                <Label
                    Text="Product not found"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="We couldn't load this product's details."
                    TextColor="Gray"
                    HorizontalTextAlignment="Center"/>

                <Button
                    Text="Go Back"
                    WidthRequest="140"
                    Command="{Binding GoBackCommand}"/>

            </VerticalStackLayout>

            <!-- Details -->
            <ScrollView
                Grid.Row="1"
                IsVisible="{Binding HasError,Converter={toolkit:InvertedBoolConverter}}">

                <VerticalStackLayout
                    Padding="15"
                    Spacing="14"
                    BindingContext="{Binding Product}"
                    x:DataType="models:Product">

                    <!-- Image -->
                    <Border
                        Padding="0"
                        HeightRequest="260"
                        BackgroundColor="White"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 18">

                        <ffimageloading:CachedImage
                            Aspect="AspectFit"
                            Source="{Binding Image,FallbackValue='backhoe_loader',TargetNullValue='backhoe_loader'}"/>

                    </Border>

                    <!-- Tier / Brand chip + Stock status -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Border
                            Grid.Column="0"
                            HorizontalOptions="Start"
                            Padding="10,4"
                            BackgroundColor="{StaticResource ChipBackground}"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="0"
                            IsVisible="{Binding HasBrandInfo}">

                            <HorizontalStackLayout Spacing="4">

                                <Label
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextTransform="Uppercase"
                                    TextColor="{StaticResource ChipText}"
                                    IsVisible="{Binding TierName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                    Text="{Binding TierName}"/>

                                <Label
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextTransform="Uppercase"
                                    TextColor="{StaticResource ChipText}"
                                    IsVisible="{Binding BrandName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                    Text="{Binding BrandName}"/>

                            </HorizontalStackLayout>

                        </Border>

                        <!-- In Stock -->
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            BackgroundColor="{StaticResource SuccessBackground}"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="0"
                            IsVisible="{Binding IsInStock}">

                            <Label
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Success}"
                                Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                        </Border>

                        <!-- Out Of Stock -->
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            BackgroundColor="{StaticResource WarningBackground}"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="0"
                            IsVisible="{Binding IsOutOfStock}">

                            <Label
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Warning}"
                                Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                        </Border>

                        <!-- Low Stock -->
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            BackgroundColor="{StaticResource DangerBackground}"
                            StrokeShape="RoundRectangle 25"
                            StrokeThickness="0"
                            IsVisible="{Binding IsLowStock}">

                            <Label
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Danger}"
                                Text="{Binding StockStatusDisplay,StringFormat='● {0}'}"/>

                        </Border>

                    </Grid>

                    <!-- Category -->
                    <Label
                        FontSize="12"
                        TextColor="Gray"
                        TextTransform="Uppercase"
                        CharacterSpacing="0.5"
                        IsVisible="{Binding CategoryName,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                        Text="{Binding CategoryName}"/>

                    <!-- Name -->
                    <Label
                        FontSize="22"
                        FontAttributes="Bold"
                        Text="{Binding Name}"/>

                    <!-- Part No / SKU -->
                    <VerticalStackLayout Spacing="2">

                        <Label
                            FontSize="13"
                            TextColor="Gray"
                            IsVisible="{Binding PartNumber,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                            Text="{Binding PartNumber,StringFormat='Part No: {0}'}"/>

                        <Label
                            FontSize="12"
                            TextColor="Gray"
                            Opacity="0.8"
                            IsVisible="{Binding Sku,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                            Text="{Binding Sku,StringFormat='SKU: {0}'}"/>

                    </VerticalStackLayout>

                    <!-- Rating -->
                    <HorizontalStackLayout
                        Spacing="6"
                        IsVisible="{Binding HasRating}">

                        <Label
                            FontAttributes="Bold"
                            Text="{Binding AverageRating,StringFormat='★ {0:F1}'}"
                            TextColor="{StaticResource Accent}"/>

                        <Label
                            VerticalOptions="Center"
                            TextColor="Gray"
                            Text="{Binding ReviewCount,StringFormat='({0} reviews)'}"/>

                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Border}"/>

                    <!-- Pricing -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="Gray"
                            TextTransform="Uppercase"
                            CharacterSpacing="0.5"
                            Text="Pricing"/>

                        <!-- Priced -->
                        <HorizontalStackLayout Spacing="10"
                                               IsVisible="{Binding RequiresEnquiry,Converter={toolkit:InvertedBoolConverter}}">

                            <Label
                                FontSize="26"
                                FontAttributes="Bold"
                                Text="{Binding Price,StringFormat='₹ {0:F0}'}"
                                TextColor="{StaticResource Accent}"/>

                            <Label
                                VerticalOptions="Center"
                                FontSize="16"
                                TextDecorations="Strikethrough"
                                TextColor="Gray"
                                IsVisible="{Binding HasDiscount}"
                                Text="{Binding Mrp,StringFormat='₹ {0:F0}'}"/>

                            <Label
                                VerticalOptions="Center"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Success}"
                                IsVisible="{Binding HasDiscount}"
                                Text="{Binding DiscountPercent,StringFormat='{0:F0}% off'}"/>

                        </HorizontalStackLayout>

                        <!-- Contact Quote -->
                        <Label
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Accent}"
                            IsVisible="{Binding RequiresEnquiry}"
                            Text="₹ Contact Quote"/>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Border}"/>

                    <!-- Description -->
                    <Label
                        StyleClass="SectionTitle"
                        Text="Description"
                        IsVisible="{Binding Description,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

                    <Label
                        FontSize="14"
                        Opacity="0.8"
                        Text="{Binding Description}"
                        IsVisible="{Binding Description,Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

                    <!-- Add To Cart -->
                    <Button
                        Margin="0,10,0,0"
                        HeightRequest="52"
                        Text="Add To Cart"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="White"
                        CornerRadius="14"
                        IsVisible="{Binding CanAddToCart}"
                        Command="{Binding BindingContext.AddToCartCommand, Source={RelativeSource AncestorType={x:Type views:ProductDetailPage}}}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="{x:Static fontresources:FontAwesomeIcons.Plus}"
                                             Size="16"
                                             Color="White"/>
                        </Button.ImageSource>

                    </Button>

                    <!-- Enquire -->
                    <Button
                        Margin="0,10,0,0"
                        HeightRequest="52"
                        Text="Enquire"
                        BackgroundColor="White"
                        TextColor="{StaticResource TitleText}"
                        BorderColor="{StaticResource Border}"
                        BorderWidth="1"
                        CornerRadius="14"
                        IsVisible="{Binding RequiresEnquiry}"
                        Command="{Binding BindingContext.EnquireCommand, Source={RelativeSource AncestorType={x:Type views:ProductDetailPage}}}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="{x:Static fontresources:FontAwesomeIcons.Comment}"
                                             Size="16"
                                             Color="{StaticResource TitleText}"/>
                        </Button.ImageSource>

                    </Button>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>
    </views:BasePage.PageContent>

</views:BasePage>
