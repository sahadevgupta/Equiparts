<?xml version="1.0" encoding="utf-8" ?>

<views:BasePage
    x:Class="Equiparts.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Equiparts.Controls"
    xmlns:viewModels="clr-namespace:Equiparts.ViewModels"
    xmlns:views="clr-namespace:Equiparts.Views"
    xmlns:fontresources="clr-namespace:Equiparts.Extensions"
    x:DataType="viewModels:RegisterViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <views:BasePage.PageContent>
        <ScrollView>
            <Grid>

                <!-- White card: sits behind the header curve, holds all of the form content -->
                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="Transparent"
                        Margin="20,90,20,30"
                        VerticalOptions="Start"
                        Padding="24,160,24,28">

                    <Border.StrokeShape>
                        <Rectangle/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#22000000"
                                Offset="0,6"
                                Radius="16"
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Create your account"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TitleText}"
                               HorizontalOptions="Center"/>

                        <Label Text="Sign up to get started with Equiparts Groups"
                               FontSize="14"
                               TextColor="{StaticResource BodyText}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,4"/>

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource ErrorColor}"
                               FontSize="13"
                               IsVisible="{Binding HasError}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Full name -->
                        <controls:ExtendedEntry Text="{Binding FullName}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.User}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Full name"/>

                        <!-- Email -->
                        <controls:ExtendedEntry Text="{Binding Email}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Envelope}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Enter email"/>

                        <!-- Password -->
                        <controls:ExtendedEntry Text="{Binding Password}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Create password"
                                                 IsPassword="True"/>

                        <!-- Confirm password -->
                        <controls:ExtendedEntry Text="{Binding ConfirmPassword}"
                                                 LeadingIcon="{x:Static fontresources:FontAwesomeIcons.Lock}"
                                                 LeadingIconType="Font"
                                                 PlaceholderText="Confirm password"
                                                 IsPassword="True"/>

                        <!-- Register button -->
                        <Border BackgroundColor="{StaticResource Primary}"
                                Stroke="Transparent"
                                HeightRequest="54"
                                Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <Rectangle/>
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RegisterCommand}"/>
                            </Border.GestureRecognizers>

                            <Grid>
                                <Label Text="Create Account"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>

                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="White"
                                        Stroke="Transparent"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Margin="0,0,10,0">
                                    <Border.StrokeShape>
                                        <Rectangle/>
                                    </Border.StrokeShape>

                                    <Label Text="{x:Static fontresources:FontAwesomeIcons.ArrowRight}"
                                           FontFamily="FontAwesome"
                                           FontSize="14"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Accent}"
                                           HorizontalOptions="Center"/>

                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="4"
                                               Margin="0,10,0,0">
                            <Label Text="Already have an account?"
                                   FontSize="14"
                                   TextColor="{StaticResource BodyText}"/>

                            <Label Text="Sign In"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource LinkColor}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToLoginCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Curved navy header, drawn on top so its wavy bottom edge carves into the card -->
                <GraphicsView x:Name="HeaderGraphics"
                              HeightRequest="240"
                              VerticalOptions="Start"
                              InputTransparent="True"/>

                <!-- Logo badge, straddling the header/card boundary -->
                <Border WidthRequest="96"
                        HeightRequest="96"
                        Stroke="White"
                        StrokeThickness="4"
                        BackgroundColor="{StaticResource PrimaryDark}"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="0,135,0,0"
                        InputTransparent="True"
                        Padding="3">
                    <Border.StrokeShape>
                        <Rectangle/>
                    </Border.StrokeShape>

                    <Image Source="ep_logo"/>
                </Border>

            </Grid>
        </ScrollView>
    </views:BasePage.PageContent>

</views:BasePage>
