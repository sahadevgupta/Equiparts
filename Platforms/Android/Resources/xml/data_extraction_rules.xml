<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusion as auto_backup_rules.xml, for both cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.equipartsgroup.equiparts.microsoft.maui.essentials.preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.equipartsgroup.equiparts.microsoft.maui.essentials.preferences.xml" />
    </device-transfer>
</data-extraction-rules>
